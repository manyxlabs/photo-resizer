---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<section class="explainer" aria-label={title}>
  <h2>{title}</h2>
  <ul><slot /></ul>
</section>

<style>
  .explainer {
    margin-top: 56px;
  }

  h2 {
    font-size: 1.25rem;
  }

  ul {
    display: grid;
    gap: 8px;
    margin: 12px 0 0;
    padding-left: 20px;
  }

  /* Slotted links keep the page's scope, so this has to reach them globally. */
  ul :global(a) {
    color: rgb(var(--accent-text));
  }
</style>
