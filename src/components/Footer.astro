---
import { pageLocale } from '../i18n';
import { EMAIL, FOUNDER, GITHUB } from '../site';

const REPO = `${GITHUB}/photo-resizer`;
const { t, href } = pageLocale(Astro.url);
---

<footer class="wrap">
  <div class="foot">
    <p>&copy; {new Date().getFullYear()} {t.footer.place}</p>
    <nav aria-label={t.footer.nav}>
      <a href={href('/tools/')}>{t.footer.tools}</a>
      <a href={href('/photo-size/')}>{t.footer.guides}</a>
      <a href={REPO} target="_blank" rel="noopener">{t.footer.source}</a>
      <a href={`${REPO}/issues/new`} target="_blank" rel="noopener">{t.footer.issue}</a>
      <a href={`${REPO}/blob/main/CONTRIBUTING.md`} target="_blank" rel="noopener">{t.footer.contribute}</a>
      <a href={FOUNDER}>{t.footer.founder}</a>
      <a href={`mailto:${EMAIL}`}>{t.footer.email}</a>
    </nav>
  </div>
</footer>

<style>
  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    justify-content: space-between;
    padding-block: 32px 40px;
    border-top: 1px solid rgb(var(--fg) / 0.1);
    color: rgb(var(--muted));
    font-size: 0.875rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }

  nav a {
    text-decoration: none;
  }

  nav a:hover {
    color: rgb(var(--fg));
  }
</style>
