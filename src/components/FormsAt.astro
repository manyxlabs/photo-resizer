---
import { kbRange, specsCapped, type Exam, type FormSpec } from '../data/formSpecs';
import { pageLocale } from '../i18n';
import { fmt } from '../i18n/format';

interface Props {
  kb: number;
  /** Only signatures and other scans, or only photos; both when unset. */
  scan?: boolean;
}

const { kb, scan } = Astro.props;
const capped = specsCapped(kb, scan);
const { t, href } = pageLocale(Astro.url);
const item = (exam: Exam['id'], spec: FormSpec) =>
  fmt(t.formsAt.item, { exam: t.exams[exam].name, spec: t.specs[spec.id].noun, width: spec.width, height: spec.height, range: kbRange(t.sizes, spec) });
---

{
  capped.length > 0 && (
    <p class="forms">
      {`${fmt(scan ? t.formsAt.signatures : t.formsAt.files, { kb })} `}
      {capped.map(({ exam, spec }, i) => (
        <>
          {i > 0 && ' · '}
          <a href={href(`/photo-size/${exam.id}/#${spec.id}`)}>{item(exam.id, spec)}</a>
        </>
      ))}
      {t.formsAt.pick}
    </p>
  )
}

<style>
  .forms {
    margin-top: 16px;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  a {
    color: var(--accent);
  }
</style>
