---
import { checkedOn, examOf, exams, outputLine, reportHref } from '../data/formSpecs';
import { catalogues, pageLocale } from '../i18n';
import { fmt } from '../i18n/format';
import Copy from './Copy.astro';

interface Props {
  /**
   * Narrows the presets to photos or to scans. The photo tool also frames the face and
   * offers a print sheet; the scan tool also trims to the ink.
   */
  kind?: 'photo' | 'scan';
  /** Starts on a custom size with this file size limit, for pages like "photo under 50 KB". */
  maxKB?: number;
}

const { kind, maxKB } = Astro.props;
// The photo tool is the passport photo maker, so it opens on the passport.
const ordered = kind === 'photo' ? [...exams].sort((a, b) => Number(b.id === 'passport') - Number(a.id === 'passport')) : exams;
const offered = ordered
  .map((exam) => ({ exam, specs: exam.specs.filter((s) => !kind || s.scan === (kind === 'scan')) }))
  .filter((g) => g.specs.length);
const { locale, t: all } = pageLocale(Astro.url);
const t = all.resizer;
// Rendered for the preset the page opens on, so the script filling them in shifts nothing.
const first = maxKB === undefined ? offered[0]!.specs[0]! : undefined;
// The script swaps these in as the preset changes, so it needs no catalogue of its own.
const presets = Object.fromEntries(
  offered.flatMap(({ exam, specs }) =>
    specs.map((s) => [s.id, { source: all.exams[exam.id].source, url: exam.source, report: reportHref(catalogues.en, s) }]),
  ),
);
const script = { js: t.js, sizes: all.sizes, presets, report: reportHref(catalogues.en) };
---

<form id="tool" class="tool" data-kind={kind ?? ''} data-t={JSON.stringify(script)} novalidate>
  <section class="panel glass">
    <h2><span>1</span> {kind === 'scan' ? t.pickScan : kind === 'photo' ? t.pickPhoto : t.pickAny}</h2>
    <label class="drop" id="drop">
      <input id="file" type="file" accept="image/*,.heic,.heif,.tif,.tiff" />
      <strong>{t.choose}</strong>
      <span>{t.drop}</span>
    </label>
    <p id="file-status" class="hint" aria-live="polite" hidden></p>
    <p id="file-error" class="error" role="alert" hidden></p>
  </section>

  <section class="panel glass">
    <h2><span>2</span> {t.ask}</h2>
    <label class="field">
      {t.form}
      <select id="preset">
        {
          offered.map(({ exam, specs }) => (
            <optgroup label={all.exams[exam.id].name}>
              {specs.map((s) => (
                <option value={s.id}>{fmt(t.option, { exam: all.exams[exam.id].name, spec: all.specs[s.id].label })}</option>
              ))}
            </optgroup>
          ))
        }
        <option value="custom" selected={maxKB !== undefined}>{t.custom}</option>
      </select>
    </label>

    <div id="custom" class="grid" hidden>
      <label class="field">{t.width} <input id="w" type="number" min="1" step="any" inputmode="decimal" value={kind === 'scan' ? '6' : '3.5'} /></label>
      <label class="field">{t.height} <input id="h" type="number" min="1" step="any" inputmode="decimal" value={kind === 'scan' ? '2' : '4.5'} /></label>
      <label class="field">
        {t.unit}
        <select id="unit">
          <option value="cm">{t.cm}</option>
          <option value="px">{t.pixels}</option>
        </select>
      </label>
      <label class="field">{t.dpi} <input id="dpi" type="number" min="72" max="1200" step="1" value={kind === 'scan' ? '200' : '300'} /></label>
      <label class="field">{t.minKB} <input id="min" type="number" min="0" step="any" value={maxKB !== undefined ? '0' : kind === 'scan' ? '10' : '20'} /></label>
      <label class="field">{t.maxKB} <input id="max" type="number" min="1" step="any" value={maxKB ?? (kind === 'scan' ? '20' : '50')} /></label>
    </div>
    <p id="spec-error" class="error" role="alert" hidden></p>
    <p id="spec" class="hint">{first && outputLine(all.sizes, first)}</p>
    <p class="hint">
      <span id="source" hidden={!first}>
        <Copy
          text={t.source}
          parts={{ source: { text: first ? presets[first.id]!.source : '', href: first && examOf(first).source, id: 'source-link' } }}
          vars={{ checked: checkedOn(locale) }}
        />{' '}
      </span>
      {t.rules} <a id="report" href={script.report}>{t.report}</a>
    </p>
  </section>

  <section class="panel glass" id="adjust" hidden>
    <h2><span>3</span> {t.adjust}</h2>
    <div class="stage">
      <canvas id="canvas" tabindex="0" aria-label={t.preview}></canvas>
    </div>
    <label class="field">
      {t.zoom}
      <input id="zoom" type="range" min="0" max="1" step="0.001" value="0" />
    </label>
    <div class="options">
      <label class="check" id="clean-row"><input id="clean" type="checkbox" /> {t.clean}</label>
      <label class="field ink" id="ink-row">
        {t.ink}
        <select id="ink">
          <option value="as-written">{t.asWritten}</option>
          <option value="black">{t.black}</option>
          <option value="blue">{t.blue}</option>
        </select>
      </label>
      <label class="check" id="white-row"><input id="white" type="checkbox" /> {t.white}</label>
    </div>
    <p id="work" class="hint" aria-live="polite" hidden></p>

    <div class="result">
      <p id="result" aria-live="polite"></p>
      <div class="actions">
        <button id="sheet" class="btn" type="button" hidden>{t.sheet}</button>
        <a id="download" class="btn primary" download hidden>{t.download}</a>
      </div>
    </div>
  </section>
</form>

<script>
  import { openImage } from '../lib/decode';
  import { fitJpeg, maxBytes, minBytes, withDpi } from '../lib/jpeg';
  import { cleanScan, type Ink } from '../lib/scan';
  import type { Box } from '../lib/vision';
  import { exams, outputLine, type FormSpec, type SpecId } from '../data/formSpecs';
  import type { Messages } from '../i18n/en';
  import { fmt } from '../i18n/format';

  const formSpecs = exams.flatMap((e) => e.specs);

  type Target = {
    width: number;
    height: number;
    min: number;
    max: number;
    /** As the form states them, for display; min and max are the byte limits actually enforced. */
    minKB: number;
    maxKB: number;
    dpi?: number;
    scan: boolean;
    fileName?: string;
    /** Printed size in cm, for the print sheet. */
    physical?: FormSpec['physical'];
  };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const form = $<HTMLFormElement>('tool');
  const kind = form.dataset.kind;
  const fileInput = $<HTMLInputElement>('file');
  const drop = $<HTMLLabelElement>('drop');
  const fileError = $<HTMLParagraphElement>('file-error');
  const fileStatus = $<HTMLParagraphElement>('file-status');
  const preset = $<HTMLSelectElement>('preset');
  const custom = $<HTMLDivElement>('custom');
  const specError = $<HTMLParagraphElement>('spec-error');
  const specLine = $<HTMLParagraphElement>('spec');
  const source = $<HTMLSpanElement>('source');
  const sourceLink = $<HTMLAnchorElement>('source-link');
  const report = $<HTMLAnchorElement>('report');
  const adjust = $<HTMLElement>('adjust');
  const canvas = $<HTMLCanvasElement>('canvas');
  const zoom = $<HTMLInputElement>('zoom');
  const clean = $<HTMLInputElement>('clean');
  const ink = $<HTMLSelectElement>('ink');
  const white = $<HTMLInputElement>('white');
  const work = $<HTMLParagraphElement>('work');
  const result = $<HTMLParagraphElement>('result');
  const download = $<HTMLAnchorElement>('download');
  const sheet = $<HTMLButtonElement>('sheet');
  const ctx = canvas.getContext('2d', { willReadFrequently: true })!;
  const { js: t, sizes, presets, report: reportAny }: {
    js: Messages['resizer']['js'];
    sizes: Messages['sizes'];
    presets: Partial<Record<SpecId, { source: string; url: string; report: string }>>;
    report: string;
  } = JSON.parse(form.dataset.t!);
  const num = (id: string) => Number($<HTMLInputElement>(id).value);

  let image: ImageBitmap | null = null;
  // Each derived version of the image is made once per image and option, on first use.
  let cleaned: { ink: Ink; bitmap: ImageBitmap; inkBox: Box | null } | null = null;
  let whitened: ImageBitmap | null = null;
  let face: Box | null | undefined;
  let target: Target | null = null;
  let offset = { x: 0, y: 0 };
  let url = '';
  let job = 0;

  function show(el: HTMLElement, text: string) {
    el.textContent = text;
    el.hidden = !text;
  }

  function readTarget(): Target | string {
    const spec = formSpecs.find((s) => s.id === preset.value);
    if (spec) {
      const { width, height, minKB, maxKB, scan, fileName, physical } = spec;
      return { width, height, min: minBytes(minKB), max: maxBytes(maxKB), minKB, maxKB, dpi: physical?.dpi, scan, fileName, physical };
    }
    const cm = $<HTMLSelectElement>('unit').value === 'cm';
    const dpi = num('dpi');
    const toPx = (v: number) => Math.round(cm ? (v / 2.54) * dpi : v);
    const [width, height, minKB, maxKB] = [toPx(num('w')), toPx(num('h')), num('min'), num('max')];
    if (!Number.isInteger(dpi) || dpi < 72 || dpi > 1200) return t.dpiRange;
    if (!(width >= 16 && height >= 16 && width <= 6000 && height <= 6000))
      return t.sizeRange;
    if (!(maxKB > 0) || !(minKB >= 0)) return t.needKB;
    if (minBytes(minKB) >= maxBytes(maxKB)) return t.minUnderMax;
    const physical = cm ? { w: num('w'), h: num('h'), dpi } : undefined;
    return { width, height, min: minBytes(minKB), max: maxBytes(maxKB), minKB, maxKB, dpi, scan: kind === 'scan', physical };
  }

  // The zoom slider runs from "whole image visible" to 4x "frame filled", on a log scale.
  function bounds(image: ImageBitmap, target: Target) {
    const contain = Math.min(target.width / image.width, target.height / image.height);
    const cover = Math.max(target.width / image.width, target.height / image.height);
    return { contain, cover, range: (cover * 4) / contain, filled: Math.log(cover / contain) / Math.log((cover * 4) / contain) };
  }

  function scale() {
    if (!image || !target) return 1;
    const { contain, range } = bounds(image, target);
    return contain * Math.pow(range, Number(zoom.value));
  }

  function clamp() {
    if (!image || !target) return;
    const s = scale();
    const axis = (pos: number, frame: number, size: number) =>
      size <= frame ? (frame - size) / 2 : Math.min(0, Math.max(frame - size, pos));
    offset = { x: axis(offset.x, target.width, image.width * s), y: axis(offset.y, target.height, image.height * s) };
  }

  /** Zooms so the image is drawn at scale `s`, with `box`'s centre at `at` (fractions of the frame). */
  function frame(box: Box, s: number, at: { x: number; y: number }) {
    if (!image || !target) return;
    const { contain, range } = bounds(image, target);
    zoom.value = String(Math.min(1, Math.max(0, Math.log(s / contain) / Math.log(range))));
    const k = scale();
    offset = { x: at.x * target.width - (box.x + box.width / 2) * k, y: at.y * target.height - (box.y + box.height / 2) * k };
    clamp();
  }

  function startView() {
    if (!image || !target) return;
    const tg = target;
    const { cover, filled } = bounds(image, tg);
    zoom.value = String(tg.scan ? 0 : filled);
    const s = scale();
    offset = { x: (tg.width - image.width * s) / 2, y: (tg.height - image.height * s) / 2 };
    const box = tg.scan ? cleaned?.inkBox : face;
    if (!box) return;
    if (tg.scan) frame(box, Math.min(tg.width / box.width, tg.height / box.height) * 0.86, { x: 0.5, y: 0.5 });
    // A passport-style crop. The head, crown to chin, is about 1.4 times the detected face box
    // and starts about half a box above it; this makes it 72% of the height, 8% from the top.
    else frame(box, Math.max(cover, (tg.height * 0.52) / box.height), { x: 0.5, y: 0.62 });
  }

  function drawn(): ImageBitmap | null {
    if (!image || !target) return null;
    if (target.scan && clean.checked && cleaned?.ink === ink.value) return cleaned.bitmap;
    if (!target.scan && white.checked && whitened) return whitened;
    return image;
  }

  function draw() {
    const from = drawn();
    if (!image || !target || !from) return;
    const s = scale();
    ctx.fillStyle = '#fff';
    ctx.fillRect(0, 0, target.width, target.height);
    ctx.imageSmoothingQuality = 'high';
    // Derived versions can be smaller than the original; they are drawn at the original's size.
    ctx.drawImage(from, offset.x, offset.y, image.width * s, image.height * s);
  }

  const kb = (bytes: number) => `${(bytes / 1024).toFixed(1)} KB`;

  async function render() {
    const mine = ++job;
    if (!image || !target) return;
    const { width, height, dpi } = target;
    draw();
    const encode = (q: number) =>
      new Promise<Uint8Array>((resolve, reject) =>
        canvas.toBlob(
          (b) => (b ? b.arrayBuffer().then((a) => resolve(dpi ? withDpi(new Uint8Array(a), dpi) : new Uint8Array(a))) : reject()),
          'image/jpeg',
          q,
        ),
      );
    const fit = await fitJpeg(encode, target);
    if (mine !== job) return;
    if (!fit.ok) {
      result.textContent = fmt(t.tooBig, { size: kb(fit.smallest) });
      return;
    }
    URL.revokeObjectURL(url);
    url = URL.createObjectURL(new Blob([fit.jpeg as BlobPart], { type: 'image/jpeg' }));
    download.href = url;
    download.download = target.fileName ? `${target.fileName}.jpg` : `${preset.value === 'custom' ? 'image' : preset.value}-${width}x${height}.jpg`;
    download.hidden = false;
    result.textContent =
      fmt(t.result, { width, height, size: kb(fit.jpeg.length) }) +
      (dpi ? fmt(t.resultDpi, { dpi }) : '') +
      (fit.padded ? t.padded : fmt(t.quality, { quality: Math.round(fit.quality * 100) }));
  }

  let timer = 0;
  const later = () => {
    // The link would otherwise hand out the previous file until the new one is encoded.
    download.hidden = true;
    draw();
    clearTimeout(timer);
    timer = window.setTimeout(render, 150);
  };

  /** Makes the derived images the current options need. Returns false if a newer image replaced this one meanwhile. */
  async function prepare(): Promise<boolean> {
    const img = image;
    if (!img || !target) return true;
    // A render queued before this would publish a file without the result being prepared.
    clearTimeout(timer);
    job++;
    download.hidden = true;
    if (target.scan && clean.checked && cleaned?.ink !== ink.value) {
      cleaned?.bitmap.close();
      cleaned = { ink: ink.value as Ink, ...cleanScan(img, ink.value as Ink) };
    }
    const vision = kind === 'photo' || (!target.scan && white.checked);
    if (!vision) return true;
    const needFace = kind === 'photo' && face === undefined;
    const needWhite = !target.scan && white.checked && !whitened;
    if (!needFace && !needWhite) return true;
    show(work, needWhite ? t.findingBackground : t.findingFace);
    try {
      const { findFace, onWhite } = await import('../lib/vision');
      if (needFace) {
        const found = await findFace(img);
        if (img !== image) return false;
        face = found;
      }
      if (needWhite) {
        const made = await onWhite(img);
        if (img !== image) return made.close(), false;
        whitened = made;
      }
      show(work, '');
    } catch {
      if (img !== image) return false;
      if (needFace) face = null;
      if (needWhite) white.checked = false;
      show(work, needWhite ? t.backgroundFailed : '');
    }
    return true;
  }

  function showOptions() {
    const scan = target?.scan ?? false;
    $('clean-row').hidden = !scan;
    $('ink-row').hidden = !scan || !clean.checked;
    $('white-row').hidden = scan;
    sheet.hidden = !target || scan || kind !== 'photo';
  }

  async function applyTarget() {
    custom.hidden = preset.value !== 'custom';
    const spec = presets[preset.value as SpecId];
    source.hidden = !spec;
    if (spec) {
      sourceLink.href = spec.url;
      sourceLink.textContent = spec.source;
    }
    report.href = spec?.report ?? reportAny;
    const next = readTarget();
    if (typeof next === 'string') {
      show(specError, next);
      target = null;
      download.hidden = true;
      sheet.hidden = true;
      result.textContent = '';
      return;
    }
    show(specError, '');
    specLine.textContent = outputLine(sizes, next);
    const changedShape = !target || target.width !== next.width || target.height !== next.height || target.scan !== next.scan;
    target = next;
    canvas.width = next.width;
    canvas.height = next.height;
    canvas.style.setProperty('--ratio', String(next.width / next.height));
    if (changedShape && image) {
      // Scans start cleaned and trimmed to the ink, since a cropped signature is useless.
      clean.checked = next.scan;
      showOptions();
      if (!(await prepare())) return;
      startView();
    }
    showOptions();
    clamp();
    later();
  }

  async function changeOption() {
    showOptions();
    if (await prepare()) later();
  }

  let opening = 0;
  async function load(file: File | undefined) {
    if (!file) return;
    const mine = ++opening;
    show(fileError, '');
    show(fileStatus, fmt(t.opening, { name: file.name }));
    let next: ImageBitmap;
    try {
      next = await openImage(file);
    } catch {
      if (mine === opening) {
        show(fileStatus, '');
        show(fileError, fmt(t.cantOpen, { name: file.name }));
      }
      return;
    }
    // A slow HEIC decode must not land on top of a file picked after it.
    if (mine !== opening) return next.close();
    show(fileStatus, '');
    image?.close();
    cleaned?.bitmap.close();
    whitened?.close();
    image = next;
    cleaned = null;
    whitened = null;
    face = undefined;
    adjust.hidden = false;
    target = null;
    await applyTarget();
  }

  /** Copies of the photo at its printed size on a 6 × 4 inch sheet at 300 DPI, with cut lines. */
  function printSheet() {
    if (!target) return;
    const DPI = 300;
    const ratio = target.width / target.height;
    // Without a stated print size, photos print at the common 4.5 cm passport height.
    const cm = target.physical ?? { w: 4.5 * ratio, h: 4.5 };
    const w = Math.round((cm.w / 2.54) * DPI);
    const h = Math.round((cm.h / 2.54) * DPI);
    const sheetCanvas = document.createElement('canvas');
    sheetCanvas.width = 6 * DPI;
    sheetCanvas.height = 4 * DPI;
    const cols = Math.max(1, Math.floor(sheetCanvas.width / (w + 24)));
    const rows = Math.max(1, Math.floor(sheetCanvas.height / (h + 24)));
    const gapX = (sheetCanvas.width - cols * w) / (cols + 1);
    const gapY = (sheetCanvas.height - rows * h) / (rows + 1);
    const g = sheetCanvas.getContext('2d')!;
    g.fillStyle = '#fff';
    g.fillRect(0, 0, sheetCanvas.width, sheetCanvas.height);
    g.imageSmoothingQuality = 'high';
    g.strokeStyle = '#c8c8c8';
    g.lineWidth = 2;
    for (let r = 0; r < rows; r++)
      for (let c = 0; c < cols; c++) {
        const x = Math.round(gapX + c * (w + gapX));
        const y = Math.round(gapY + r * (h + gapY));
        g.drawImage(canvas, x, y, w, h);
        g.strokeRect(x - 1, y - 1, w + 2, h + 2);
      }
    sheetCanvas.toBlob(
      async (b) => {
        if (!b) return;
        const jpeg = withDpi(new Uint8Array(await b.arrayBuffer()), DPI);
        const a = document.createElement('a');
        a.href = URL.createObjectURL(new Blob([jpeg as BlobPart], { type: 'image/jpeg' }));
        a.download = `${preset.value === 'custom' ? 'photo' : preset.value}-print-sheet-6x4in.jpg`;
        a.click();
        setTimeout(() => URL.revokeObjectURL(a.href), 10_000);
      },
      'image/jpeg',
      0.95,
    );
  }

  fileInput.addEventListener('change', () => load(fileInput.files?.[0]));
  drop.addEventListener('dragover', (e) => e.preventDefault());
  drop.addEventListener('drop', (e) => {
    e.preventDefault();
    load(e.dataTransfer?.files[0]);
  });
  preset.addEventListener('change', applyTarget);
  custom.addEventListener('input', applyTarget);
  clean.addEventListener('change', changeOption);
  ink.addEventListener('change', changeOption);
  white.addEventListener('change', changeOption);
  sheet.addEventListener('click', printSheet);
  zoom.addEventListener('input', () => {
    if (!image || !target) return;
    // Zoom around the frame centre so the subject stays put.
    const before = scale();
    const cx = (target.width / 2 - offset.x) / before;
    const cy = (target.height / 2 - offset.y) / before;
    const after = scale();
    offset = { x: target.width / 2 - cx * after, y: target.height / 2 - cy * after };
    clamp();
    later();
  });

  let dragFrom: { x: number; y: number } | null = null;
  canvas.addEventListener('pointerdown', (e) => {
    canvas.setPointerCapture(e.pointerId);
    dragFrom = { x: e.clientX, y: e.clientY };
  });
  canvas.addEventListener('pointermove', (e) => {
    if (!dragFrom || !target) return;
    const k = target.width / canvas.getBoundingClientRect().width;
    offset = { x: offset.x + (e.clientX - dragFrom.x) * k, y: offset.y + (e.clientY - dragFrom.y) * k };
    dragFrom = { x: e.clientX, y: e.clientY };
    clamp();
    later();
  });
  canvas.addEventListener('pointerup', () => (dragFrom = null));
  canvas.addEventListener('pointercancel', () => (dragFrom = null));
  canvas.addEventListener('keydown', (e) => {
    const step = e.shiftKey ? 10 : 2;
    const move = { ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, -step], ArrowDown: [0, step] }[e.key];
    if (!move) return;
    e.preventDefault();
    offset = { x: offset.x + move[0], y: offset.y + move[1] };
    clamp();
    later();
  });
  form.addEventListener('submit', (e) => e.preventDefault());

  // The size guides link here with ?preset=<id>.
  const wanted = new URLSearchParams(location.search).get('preset');
  if (wanted && [...preset.options].some((o) => o.value === wanted)) preset.value = wanted;
  applyTarget();
  // On a slow connection a file can be picked before this script has loaded and started listening.
  load(fileInput.files?.[0]);
</script>

<style>
  canvas {
    /* Wide signatures are capped by width, tall photos by height, so the box always matches the image. */
    width: min(100%, 360px, 420px * var(--ratio, 1));
    aspect-ratio: var(--ratio, 1);
    box-shadow: 0 0 0 1px var(--border);
    cursor: grab;
    touch-action: none;
  }

  canvas:active {
    cursor: grabbing;
  }

  .options {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    align-items: center;
  }

  .options:not(:has(> :not([hidden]))) {
    display: none;
  }

  .ink {
    grid-template-columns: auto 9rem;
    align-items: center;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
</style>
