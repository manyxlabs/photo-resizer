---
import { exams, guideTitle } from '../data/formSpecs';
import { PHOTO_KB, SIGN_KB } from '../data/tools';
import { pageLocale } from '../i18n';
import { fmt } from '../i18n/format';

interface Props {
  /** Narrows the guides and sizes to photos or to scans, as the page's tool does. */
  kind?: 'photo' | 'scan';
}

const { kind } = Astro.props;
const { t, href } = pageLocale(Astro.url);
const guides = exams.filter((e) => !kind || e.specs.some((s) => s.scan === (kind === 'scan')));
const sizes = [
  ...(kind === 'scan' ? [] : PHOTO_KB.map((kb) => [fmt(t.sizes.photoUnder, { kb }), href(`/tools/photo-resizer/${kb}-kb/`)])),
  ...(kind === 'photo' ? [] : SIGN_KB.map((kb) => [fmt(t.sizes.signUnder, { kb }), href(`/tools/signature-resizer/${kb}-kb/`)])),
].filter(([, href]) => href !== Astro.url.pathname);
---

<nav class="guides" aria-labelledby="guides-h">
  <h2 id="guides-h">{t.sizeLinks.heading}</h2>
  <ul>
    {
      guides.map((exam) => (
        <li>
          <a href={href(`/photo-size/${exam.id}/`)}>{guideTitle(t, exam)}</a>
        </li>
      ))
    }
  </ul>
  <p class="sizes">
    {t.sizeLinks.under}{' '}
    {
      sizes.map(([name, href], i) => (
        <>
          {i > 0 && ' · '}
          <a href={href}>{name}</a>
        </>
      ))
    }
  </p>
</nav>

<style>
  .guides {
    margin-top: 56px;
  }

  h2 {
    font-size: 1.25rem;
  }

  ul {
    display: grid;
    gap: 6px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  a {
    color: rgb(var(--accent-text));
  }

  .sizes {
    margin-top: 16px;
    color: rgb(var(--muted));
    font-size: 0.9375rem;
  }
</style>
