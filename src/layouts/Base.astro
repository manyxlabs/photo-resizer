---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
// Latin covers every page's text, so fetching it early keeps the swap from shifting layout late.
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import { FONTS, fontFace } from '../i18n/fonts';
import { graphemes } from '../i18n/format';
import { pageLocale } from '../i18n';
import { LOCALES, localePath } from '../i18n/locales';
import { ogImage } from '../seo';

type Props = {
  /** Without the brand, which is added when the whole still fits a search result (60 characters). */
  title: string;
  description: string;
  /** schema.org objects, for search results. */
  schema?: Record<string, unknown>[];
} & ({ og: string; noindex?: never } | { og?: never; noindex: true });

const { title, description, schema = [], og } = Astro.props;
const { locale, path } = pageLocale(Astro.url);
const brand = ' - Manyx Labs';
const fullTitle = graphemes(title + brand) <= 60 ? title + brand : title;
// "</script>" inside a string would end the tag early.
const ld = (o: Record<string, unknown>) => JSON.stringify({ '@context': 'https://schema.org', ...o }).replace(/</g, '\\u003c');
const canonical = new URL(Astro.url.pathname, Astro.site);
const font = locale === 'en' ? undefined : FONTS[locale];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    {font && <link rel="preload" href={font.url} as="font" type="font/woff2" crossorigin />}
    {font && <style is:inline set:html={`${fontFace(font)}:root{--script:'${font.family}'}`} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#050506" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)" />
    {
      og ? (
        <>
          <link rel="canonical" href={canonical} />
          {LOCALES.map((l) => (
            <link rel="alternate" hreflang={l} href={new URL(localePath(l, path), Astro.site)} />
          ))}
          <link rel="alternate" hreflang="x-default" href={new URL(path, Astro.site)} />
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content="Manyx Labs" />
          <meta property="og:locale" content={`${locale}_IN`} />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonical} />
          <meta property="og:image" content={ogImage(og)} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={title} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      ) : (
        <meta name="robots" content="noindex" />
      )
    }
    <!-- Before first paint, so a saved or system theme never flashes the other one. -->
    <script is:inline>
      {
        const root = document.documentElement;
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme ? theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches) root.classList.add('dark');
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) root.classList.add('motion');
      }
    </script>
    {schema.map((o) => <script type="application/ld+json" set:html={ld(o)} />)}
  </head>
  <body>
    <div class="backdrop" aria-hidden="true"><div class="halo"></div><div class="bg-dots"></div></div>
    <div class="progress" aria-hidden="true"></div>
    <slot />
  </body>
</html>

<script>
  const reveal = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        e.target.classList.add('shown');
        reveal.unobserve(e.target);
      }
    },
    { threshold: 0.15 },
  );
  for (const el of document.querySelectorAll('.reveal')) reveal.observe(el);

  // Spotlight cards: the glow follows the pointer, and the card tilts slightly towards it.
  const tilt = !matchMedia('(prefers-reduced-motion: reduce)').matches;
  let active: HTMLElement | null = null;
  addEventListener('pointermove', (e) => {
    const el = (e.target as Element).closest<HTMLElement>('.spotlight');
    if (active && active !== el) active.style.rotate = '';
    active = el;
    if (!el) return;
    const rect = el.getBoundingClientRect();
    const [px, py] = [e.clientX - rect.left, e.clientY - rect.top];
    el.style.setProperty('--x', `${px}px`);
    el.style.setProperty('--y', `${py}px`);
    if (!tilt) return;
    const [nx, ny] = [(px / rect.width) * 2 - 1, (py / rect.height) * 2 - 1];
    const amount = Math.hypot(nx, ny);
    el.style.rotate = amount ? `${-ny} ${nx} 0 ${amount * 2.5}deg` : '';
  });
</script>

<style is:global>
  /* Tokens, glass, buttons and chips copy src/index.css of the portfolio at www.manishonai.in,
     the design every Manyx Labs product follows; change them there first. The tools and the company site
     share www.manyxlabs.com, so this block is identical in both repos' Base.astro.
     Colours are RGB channels, used as rgb(var(--x) / alpha). */
  :root {
    --ink: 245 245 247;
    --fg: 29 29 31;
    --muted: 99 99 102;
    --accent: 5 150 105;
    /* The light accent is 3.5:1 on ink, under AA for text, so accent text uses a deeper emerald. */
    --accent-text: 4 120 87;
    --glass-bg: linear-gradient(180deg, rgb(255 255 255 / 0.6), rgb(255 255 255 / 0.25));
    --glass-shadow: 0 8px 32px -8px rgb(0 0 0 / 0.12);
    --rim-hi: rgb(255 255 255 / 0.95);
    --rim-lo: rgb(0 0 0 / 0.07);
    --dot: rgb(0 0 0 / 0.16);
    --halo: rgb(255 255 255 / 0.9);
    --spot: rgb(0 0 0 / 0.04);
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    --mono: 'Geist Mono Variable', var(--script, ui-monospace), ui-monospace, monospace;
    color-scheme: light;
  }

  .dark {
    --ink: 5 5 6;
    --fg: 245 245 247;
    --muted: 161 161 166;
    --accent: 52 211 153;
    --accent-text: 52 211 153;
    --glass-bg: linear-gradient(180deg, rgb(44 44 48 / 0.55), rgb(24 24 26 / 0.4));
    --glass-shadow: 0 8px 32px -8px rgb(0 0 0 / 0.5);
    --rim-hi: rgb(255 255 255 / 0.22);
    --rim-lo: rgb(255 255 255 / 0.04);
    --dot: rgb(255 255 255 / 0.09);
    --halo: rgb(255 255 255 / 0.07);
    --spot: rgb(255 255 255 / 0.06);
    color-scheme: dark;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  body {
    margin: 0;
    min-height: 100vh;
    background: rgb(var(--ink));
    color: rgb(var(--fg));
    /* Geist for Latin text and digits, then the page's own script, if it has one. */
    font-family: 'Geist Variable', var(--script, system-ui), system-ui, sans-serif;
    font-size: 1rem;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    transition:
      color 0.3s,
      background-color 0.3s;
  }

  ::selection {
    background: rgb(var(--accent) / 0.4);
    color: rgb(var(--fg));
  }

  /* Solid accent rather than the portfolio's 70%, which is under 3:1 on the light page. */
  :focus-visible {
    outline: 2px solid rgb(var(--accent));
    outline-offset: 2px;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  h1,
  h2,
  h3 {
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  /* Indic matras reach above and below the Latin line, and letter-spacing pulls conjuncts apart.
     :root lifts this over the pages' scoped heading styles. */
  :root :is(h1, h2, h3, .eyebrow):not(:lang(en)) {
    line-height: 1.4;
    letter-spacing: normal;
  }

  a {
    color: inherit;
  }

  .lede {
    color: rgb(var(--muted));
    font-size: 1.125rem;
    line-height: 1.625;
  }

  .eyebrow {
    color: rgb(var(--accent-text));
    font-family: var(--mono);
    font-size: 0.875rem;
  }

  a.link {
    color: rgb(var(--accent-text));
  }

  /* The fixed layer every page sits on. Glass needs this texture behind it to frost;
     on a flat background it would read as a plain card. */
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .halo {
    position: absolute;
    top: -30vmax;
    left: 50%;
    width: 100vmax;
    height: 60vmax;
    translate: -50% 0;
    background: radial-gradient(closest-side, var(--halo), transparent);
  }

  .bg-dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--dot) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse 90% 80% at 50% 30%, black, transparent);
  }

  /* Scroll-driven, so it needs no script; where unsupported it stays hidden. */
  .progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    height: 2px;
    background: rgb(var(--accent));
    scale: 0 1;
    transform-origin: left;
  }

  @supports (animation-timeline: scroll()) {
    .progress {
      animation: progress linear both;
      animation-timeline: scroll(root);
    }
  }

  @keyframes progress {
    to {
      scale: 1 1;
    }
  }

  /* Every glass surface must sit over .backdrop; an ancestor with opacity < 1 or a filter becomes
     the backdrop root and the blur goes flat. Saturation keeps what is behind the glass from greying out. */
  :is(.glass, .btn-glass, .btn-icon) {
    position: relative;
    background: var(--glass-bg);
    box-shadow: var(--glass-shadow);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    backdrop-filter: blur(24px) saturate(180%);
  }

  /* Specular rim: a 1px gradient border, brightest where light would catch the top-left and bottom-right edges. */
  :is(.glass, .btn-glass, .btn-icon)::after {
    content: '';
    position: absolute;
    inset: 0;
    padding: 1px;
    border-radius: inherit;
    background: linear-gradient(135deg, var(--rim-hi), var(--rim-lo) 35%, var(--rim-lo) 65%, var(--rim-hi));
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  @media (prefers-reduced-transparency: reduce) {
    :is(.glass, .btn-glass, .btn-icon) {
      background: rgb(var(--ink));
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border: 1px solid rgb(var(--fg) / 0.1);
    border-radius: 999px;
    background: rgb(var(--fg) / 0.05);
    color: rgb(var(--fg) / 0.8);
    font-family: var(--mono);
    font-size: 0.75rem;
    line-height: 1rem;
  }

  /* A monochrome sheen; symmetric stops with a 200% size make the shimmer loop seamless. */
  .text-sheen {
    background: linear-gradient(90deg, rgb(var(--fg)), rgb(var(--muted)), rgb(var(--fg))) 0 0 / 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  @media (prefers-reduced-motion: no-preference) {
    .text-sheen {
      animation: shimmer 6s linear infinite;
    }
  }

  @keyframes shimmer {
    to {
      background-position: 200% 50%;
    }
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 20px;
    border: 0;
    border-radius: 999px;
    color: rgb(var(--fg));
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.25rem;
    text-decoration: none;
    overflow-wrap: anywhere;
    cursor: pointer;
    transition:
      color 0.2s,
      background-color 0.2s,
      scale 0.2s,
      translate 0.2s;
  }

  .btn:active:not(:disabled) {
    scale: 0.95;
  }

  .btn-primary {
    background: rgb(var(--fg));
    color: rgb(var(--ink));
  }

  .btn-primary:hover {
    background: rgb(var(--fg) / 0.85);
  }

  :is(.btn-glass, .btn-icon):hover {
    background-color: rgb(var(--fg) / 0.1);
  }

  .btn-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 999px;
    color: rgb(var(--muted));
    font: inherit;
    cursor: pointer;
    transition:
      color 0.2s,
      background-color 0.2s,
      scale 0.2s;
  }

  .btn-icon:hover {
    color: rgb(var(--fg));
  }

  .btn-icon:active:not(:disabled) {
    scale: 0.9;
  }

  :is(.btn, .btn-icon):disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* --x/--y come from the pointer listener below. backdrop-filter makes .glass a stacking
     context, so z-index -1 keeps the glow above the card's background but under its content. */
  .spotlight {
    transition: rotate 0.4s var(--ease);
  }

  :has(> .spotlight) {
    perspective: 1200px;
  }

  .spotlight::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: radial-gradient(350px circle at var(--x) var(--y), var(--spot), transparent 60%);
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }

  .spotlight:hover::before {
    opacity: 1;
  }

  /* Hidden only once the head script has found motion allowed, so nothing stays invisible without it.
     Put .reveal on the glass element itself, never on an ancestor of one (see .glass). */
  .motion .reveal {
    opacity: 0;
  }

  .motion .reveal.shown {
    animation: reveal 0.45s var(--ease) calc(min(var(--i, 0), 6) * 50ms) both;
  }

  @keyframes reveal {
    from {
      opacity: 0;
      translate: 0 16px;
      scale: 0.98;
    }

    to {
      opacity: 1;
      translate: 0;
      scale: 1;
    }
  }

  /* Component display rules would otherwise override the hidden attribute. */
  [hidden] {
    display: none !important;
  }

  .wrap {
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: 16px;
  }

  @media (min-width: 640px) {
    .wrap {
      padding-inline: 24px;
    }
  }

  @media (min-width: 1024px) {
    .wrap {
      padding-inline: 32px;
    }
  }

  /* Cards and panels: the portfolio's rounded-3xl with p-6, sm:p-8. */
  .card {
    padding: 24px;
    border-radius: 24px;
  }

  @media (min-width: 640px) {
    .card {
      padding: 32px;
    }
  }

  /* A tools page: a narrow column under the header, with the portfolio's heading scale. */
  .page {
    max-width: 808px;
    padding-block: 40px 80px;
  }

  .page > h1 {
    font-size: 1.875rem;
    line-height: 1.2;
  }

  @media (min-width: 640px) {
    .page > h1 {
      font-size: 2.25rem;
      line-height: 1.15;
    }
  }

  @media (min-width: 1024px) {
    .page > h1 {
      font-size: 3rem;
      line-height: 1.1;
    }
  }

  .page > .lede {
    margin-top: 16px;
  }

  .page > .eyebrow + h1 {
    margin-top: 12px;
  }

  /* The building blocks every tool's form is made of. A form is a working screen: glass panels
     but no reveal or spotlight, and inputs stay opaque. */
  .tool {
    display: grid;
    gap: 16px;
    margin-top: 32px;
  }

  .panel {
    display: grid;
    gap: 16px;
    min-width: 0;
    padding: 24px;
    border-radius: 24px;
  }

  @media (min-width: 640px) {
    .panel {
      padding: 32px;
    }
  }

  .panel > h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.125rem;
  }

  .panel > h2 > span {
    display: grid;
    flex: none;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 1px solid rgb(var(--fg) / 0.1);
    border-radius: 999px;
    background: rgb(var(--fg) / 0.05);
    color: rgb(var(--fg) / 0.8);
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0;
  }

  .drop {
    position: relative;
    display: grid;
    gap: 4px;
    justify-items: center;
    padding: 28px 16px;
    border: 1px dashed rgb(var(--fg) / 0.2);
    border-radius: 16px;
    color: rgb(var(--muted));
    text-align: center;
    cursor: pointer;
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }

  .drop strong {
    color: rgb(var(--fg));
    font-weight: 600;
  }

  .drop:hover {
    border-color: rgb(var(--fg) / 0.35);
    background: rgb(var(--fg) / 0.03);
  }

  .drop:focus-within {
    border-color: rgb(var(--accent));
  }

  .drop input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  @media (min-width: 560px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .field {
    display: grid;
    gap: 6px;
    min-width: 0;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .field :is(select, input:not([type='range'], [type='checkbox'], [type='radio']), textarea) {
    width: 100%;
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid rgb(var(--fg) / 0.15);
    border-radius: 12px;
    background: rgb(var(--ink));
    color: rgb(var(--fg));
    font: inherit;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }

  .field textarea {
    padding-block: 10px;
    resize: vertical;
  }

  input[type='range'],
  .check input {
    accent-color: rgb(var(--accent));
  }

  input[type='range'] {
    width: 100%;
  }

  .check {
    display: flex;
    gap: 10px;
    align-items: center;
    font-size: 0.9375rem;
  }

  .check input {
    flex: none;
    width: 18px;
    height: 18px;
  }

  .hint {
    color: rgb(var(--muted));
    font-size: 0.875rem;
    line-height: 1.625;
  }

  .hint a {
    color: rgb(var(--accent-text));
  }

  .error {
    color: light-dark(#dc2626, #f87171);
    font-size: 0.875rem;
  }

  /* A checkerboard, so a preview's own white edges stay visible. */
  .stage {
    display: grid;
    place-items: center;
    padding: 16px;
    border-radius: 16px;
    background: repeating-conic-gradient(rgb(var(--fg) / 0.08) 0 25%, transparent 0 50%) 0 0 / 16px 16px;
  }

  .result {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
  }

  .result p {
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
  }
</style>
