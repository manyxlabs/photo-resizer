---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { toolPath, tools, type ToolId } from '../data/tools';
import { pageLocale } from '../i18n';
import { breadcrumbs, ogImage, organization } from '../seo';
import Base from './Base.astro';

interface Props {
  /** The page's tool, which also names it in breadcrumbs and "More tools". */
  tool: ToolId;
  title: string;
  description: string;
  heading: string;
  /** The lede, which the layout ends with the line that nothing is uploaded. */
  lede: string;
  applicationCategory?: string;
  /** Questions people search for, answered in plain text; shown on the page and marked up as an FAQ. */
  faq?: string[][];
  /** For a variant of a tool (e.g. a fixed KB target), the URL it adds; breadcrumbs then go through the tool. */
  variant?: { path: string; name: string };
}

const { tool, title, description, heading, lede, applicationCategory = 'UtilitiesApplication', faq = [], variant } = Astro.props;
const { locale, t, href } = pageLocale(Astro.url);
const path = href(toolPath(tool));
const name = t.tools[tool].name;
// Every language shares English's share images: one card per page per language is not worth its upkeep.
const og = tool;
---

<Base
  title={title}
  description={description}
  og={og}
  schema={[
    {
      '@type': 'WebApplication',
      name: variant?.name ?? name,
      description,
      url: new URL(variant ? href(variant.path) : path, Astro.site).href,
      image: ogImage(og),
      applicationCategory,
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      inLanguage: `${locale}-IN`,
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
      publisher: organization,
    },
    breadcrumbs([
      [t.crumbs.home, href('/')],
      [t.crumbs.tools, href('/tools/')],
      [name, path],
      ...(variant ? [[variant.name, href(variant.path)] as [string, string]] : []),
    ]),
    ...(faq.length
      ? [
          {
            '@type': 'FAQPage',
            mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
          },
        ]
      : []),
  ]}
>
  <Header />

  <main class="wrap tool-page">
    <h1>{heading}</h1>
    <p class="lede">{`${lede} ${t.onDevice}`}</p>
    <slot />

    {
      faq.length > 0 && (
        <section class="faq" aria-labelledby="faq-h">
          <h2 id="faq-h">{t.tool.questions}</h2>
          {faq.map(([q, a]) => (
            <details>
              <summary>{q}</summary>
              <p>{a}</p>
            </details>
          ))}
        </section>
      )
    }

    <nav class="more" aria-labelledby="more-h">
      <h2 id="more-h">{t.tool.more}</h2>
      <ul>
        {
          tools
            .filter((other) => other !== tool)
            .map((other) => (
              <li>
                <a href={href(toolPath(other))}>{t.tools[other].name}</a>
              </li>
            ))
        }
      </ul>
    </nav>
  </main>

  <Footer />
</Base>

<style>
  main {
    max-width: 760px;
    padding-block: 32px 64px;
  }

  h1 {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .lede {
    margin-top: 8px;
    color: var(--muted);
  }

  .more,
  .faq {
    margin-top: 40px;
  }

  .faq {
    display: grid;
    gap: 8px;
  }

  details {
    border-bottom: 1px solid var(--border);
    padding-block: 10px;
  }

  summary {
    font-weight: 550;
    cursor: pointer;
  }

  details p {
    margin-top: 6px;
    color: var(--muted);
  }

  :is(.more, .faq) h2 {
    font-size: 1.0625rem;
    font-weight: 620;
  }

  .more ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  .more a {
    color: var(--accent);
  }
</style>
