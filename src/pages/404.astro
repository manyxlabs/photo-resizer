---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page does not exist." noindex>
  <Header />
  <main class="wrap">
    <p class="code">404</p>
    <h1>This page doesn't exist.</h1>
    <p>
      <a href="/tools/">See all free tools &rarr;</a>
      <a href="/photo-size/">Photo and signature size guides &rarr;</a>
    </p>
  </main>
  <Footer />
</Base>

<style>
  main {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
    min-height: 60svh;
  }

  .code {
    color: var(--accent);
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  h1 {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    letter-spacing: -0.03em;
  }

  p:last-child {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  a {
    color: var(--accent);
    font-weight: 550;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }
</style>
