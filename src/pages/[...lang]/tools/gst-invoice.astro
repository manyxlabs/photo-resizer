---
import Copy from '../../../components/Copy.astro';
import Explainer from '../../../components/Explainer.astro';
import { pageLocale } from '../../../i18n';
import { LANG_PARAMS } from '../../../i18n/locales';
import Tool from '../../../layouts/Tool.astro';
import { STATES } from '../../../lib/money';

export const getStaticPaths = () => LANG_PARAMS.map((lang) => ({ params: { lang } }));

const { locale, t: all } = pageLocale(Astro.url);
const t = all.gst;
// Centre Jurisdiction (99) is a GSTIN code, never a place of supply.
const places = Object.entries(STATES).filter(([code]) => code !== '99');
const slabs: [string, string][] = [
  ['0', t.nil],
  ['5', '5%'],
  ['18', '18%'],
  ['40', '40%'],
];
const special: [string, string][] = [
  ['0.1', t.exporters],
  ['0.25', t.diamonds],
  ['1.5', t.polished],
  ['3', t.gold],
];
const links = {
  rule46: {
    text: t.rule46,
    href: 'https://taxinformation.cbic.gov.in/content/html/tax_repository/gst/rules/cgst_rules/active/chapter6/rule46_v1.00.html',
  },
  council: { text: t.council, href: 'https://www.pib.gov.in/PressReleasePage.aspx?PRID=2163555' },
};
---

<Tool
  tool="gst-invoice"
  title={t.title}
  description={t.description}
  heading={t.heading}
  lede={t.lede}
  applicationCategory="BusinessApplication"
  faq={t.faq}
>
  <form id="tool" class="tool" novalidate data-t={JSON.stringify(t.js)}>
    <section class="panel glass">
      <h2><span>1</span> {t.business}</h2>
      <div class="pair">
        <label class="field">{t.businessName} <input id="s-name" type="text" autocomplete="organization" /></label>
        <label class="field">
          {t.gstin}
          <input id="s-gstin" type="text" maxlength="15" autocapitalize="characters" spellcheck="false" placeholder="27ABCDE1234F1Z5" />
        </label>
      </div>
      <p id="s-gstin-error" class="error" role="alert" hidden></p>
      <p id="s-state" class="hint" hidden></p>
      <label class="field">{t.address} <textarea id="s-address" rows="3"></textarea></label>
    </section>

    <section class="panel glass">
      <h2><span>2</span> {t.customer}</h2>
      <div class="pair">
        <label class="field">{t.name} <input id="c-name" type="text" /></label>
        <label class="field">
          {t.customerGstin}
          <input id="c-gstin" type="text" maxlength="15" autocapitalize="characters" spellcheck="false" />
        </label>
      </div>
      <p id="c-gstin-error" class="error" role="alert" hidden></p>
      <label class="field">{t.address} <textarea id="c-address" rows="3"></textarea></label>
    </section>

    <section class="panel glass">
      <h2><span>3</span> {t.details}</h2>
      <div class="pair">
        <label class="field">{t.number} <input id="no" type="text" spellcheck="false" placeholder="INV/2026-27/001" /></label>
        <label class="field">{t.date} <input id="date" type="date" /></label>
      </div>
      <p id="no-error" class="error" role="alert" hidden></p>
      <div class="pair">
        <label class="field">
          {t.place}
          {/* State names are written as GST registration gives them, in English. */}
          <select id="pos" lang={locale === 'en' ? undefined : 'en'}>
            <option value="" lang={locale}>{t.chooseState}</option>
            {places.map(([code, name]) => <option value={code}>{`${name} (${code})`}</option>)}
          </select>
        </label>
        <label class="field">
          {t.reverse}
          <select id="rc">
            <option value="no">{t.no}</option>
            <option value="yes">{t.yes}</option>
          </select>
        </label>
      </div>
      <p id="tax-kind" class="hint"></p>
    </section>

    <section class="panel glass">
      <h2><span>4</span> {t.items}</h2>
      <div id="items" class="items"></div>
      <button id="add" class="btn" type="button">{t.addItem}</button>
    </section>

    <section class="panel glass">
      <h2><span>5</span> {t.payment}</h2>
      <div class="pair">
        <label class="field">{t.bank} <textarea id="bank" rows="3" placeholder={t.bankPlaceholder}></textarea></label>
        <label class="field">{t.notes} <textarea id="notes" rows="3" placeholder={t.notesPlaceholder}></textarea></label>
      </div>
      <label class="field">{t.upi} <input id="upi" type="text" spellcheck="false" placeholder="business@upi" /></label>
    </section>

    <section class="panel glass">
      <h2><span>6</span> {t.print}</h2>
      <div class="result">
        <p id="summary" aria-live="polite"></p>
        <button id="print" class="btn primary" type="button">{t.print}</button>
      </div>
      <ul id="problems" class="error" role="alert" hidden></ul>
      <p class="hint">{t.printHint}</p>
      {locale !== 'en' && <p class="hint">{t.english}</p>}
    </section>
  </form>

  <template id="item">
    <fieldset class="item">
      <legend>{t.item} <span data-k="n"></span></legend>
      <button class="remove" type="button" data-k="remove">{t.remove}</button>
      <label class="field wide">{t.itemDescription} <input data-k="desc" type="text" /></label>
      <label class="field hsn">{t.hsn} <input data-k="hsn" type="text" inputmode="numeric" spellcheck="false" /></label>
      <label class="field">{t.quantity} <input data-k="qty" type="text" inputmode="decimal" value="1" /></label>
      <label class="field">{t.unit} <input data-k="unit" type="text" placeholder="Nos" /></label>
      <label class="field">{t.rate} <input data-k="rate" type="text" inputmode="decimal" /></label>
      <label class="field">
        {t.gstRate}
        <select data-k="gst">
          <optgroup label={t.rates}>
            {slabs.map(([v, l]) => <option value={v} selected={v === '18'}>{l}</option>)}
          </optgroup>
          <optgroup label={t.specialRates}>
            {special.map(([v, l]) => <option value={v}>{l}</option>)}
          </optgroup>
        </select>
      </label>
      <p class="error wide" data-k="error" role="alert" hidden></p>
    </fieldset>
  </template>

  <div class="sheets" aria-label={t.preview}>
    <article class="invoice" lang="en">
      <header>
        <h3>Tax invoice</h3>
        <dl class="meta">
          <div><dt>Invoice no.</dt><dd data-k="no"></dd></div>
          <div><dt>Date</dt><dd data-k="date"></dd></div>
          <div><dt>Place of supply</dt><dd data-k="pos"></dd></div>
          <div><dt>Reverse charge</dt><dd data-k="rc"></dd></div>
        </dl>
      </header>
      <div class="parties">
        <section>
          <p class="label">From</p>
          <p class="name" data-k="s-name"></p>
          <p class="lines" data-k="s-address"></p>
          <p>GSTIN <span data-k="s-gstin"></span></p>
          <p>State <span data-k="s-state"></span></p>
        </section>
        <section>
          <p class="label">Bill to</p>
          <p class="name" data-k="c-name"></p>
          <p class="lines" data-k="c-address"></p>
          <p data-k="c-gstin"></p>
          <p>State <span data-k="c-state"></span></p>
        </section>
      </div>
      <div class="scroll">
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>Description</th>
              <th>HSN/SAC</th>
              <th class="n">Qty</th>
              <th class="n">Rate</th>
              <th class="n">GST</th>
              <th class="n">Taxable value</th>
            </tr>
          </thead>
          <tbody data-k="lines"></tbody>
        </table>
      </div>
      <div class="sums">
        <div class="scroll">
          <table class="taxes">
            <thead data-k="tax-head"></thead>
            <tbody data-k="taxes"></tbody>
          </table>
        </div>
        <dl class="totals" data-k="totals"></dl>
      </div>
      <p class="words">Amount in words: <b data-k="words"></b></p>
      <p class="rc-note" data-k="rc-note" hidden></p>
      <div class="foot">
        <section data-k="pay">
          <p class="label">Payment</p>
          <p class="lines" data-k="bank"></p>
          <p data-k="upi"></p>
        </section>
        <section data-k="notes-box">
          <p class="label">Notes</p>
          <p class="lines" data-k="notes"></p>
        </section>
        <div class="sign">
          <p>For <span data-k="s-name-2"></span></p>
          <span class="by">Authorised signatory</span>
        </div>
      </div>
    </article>
  </div>

  <Explainer title={t.rules}>
    {
      t.how.map((item) => (
        <li>
          <Copy text={item} parts={links} />
        </li>
      ))
    }
  </Explainer>
</Tool>

<script>
  import type { Messages } from '../../../i18n/en';
  import { fmt } from '../../../i18n/format';
  import { UTGST_STATES, STATES, gstinError, gstinState, inWords, roundPaise, rupees, toPaise } from '../../../lib/money';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const field = (id: string) => $<HTMLInputElement>(id);
  const val = (id: string) => field(id).value.trim();
  const sheet = document.querySelector<HTMLElement>('.invoice')!;
  new ResizeObserver(() => (sheet.style.zoom = String(Math.min(1, sheet.parentElement!.clientWidth / 680)))).observe(sheet.parentElement!);
  const slot = <T extends HTMLElement>(k: string, root: ParentNode = sheet) => root.querySelector(`[data-k="${k}"]`) as T;
  const set = (k: string, text: string) => (slot(k).textContent = text);
  const items = $<HTMLDivElement>('items');
  const template = $<HTMLTemplateElement>('item');
  const problems = $<HTMLUListElement>('problems');
  const t: Messages['gst']['js'] = JSON.parse($('tool').dataset.t!);
  const pos = $<HTMLSelectElement>('pos');
  const KEY = 'gst-invoice-supplier';
  const REMEMBERED = ['s-name', 's-gstin', 's-address', 'bank', 'upi'];
  // Rule 46(e): below this an unregistered customer's address is optional.
  const ADDRESS_FROM = 50000_00;
  const blank = '________________';
  const day = new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });

  type Line = { desc: string; hsn: string; qty: number; unit: string; rate: number; gst: number; taxable: number };

  function show(el: HTMLElement, text: string) {
    el.textContent = text;
    el.hidden = !text;
  }

  const cell = (text: string, cls = '') => Object.assign(document.createElement('td'), { textContent: text, className: cls });
  const row = (...cells: HTMLTableCellElement[]) => {
    const tr = document.createElement('tr');
    tr.append(...cells);
    return tr;
  };
  const percent = (rate: number) => `${rate}%`;
  const stateName = (code: string) => (STATES[code] ? `${STATES[code]} (${code})` : blank);
  const gstinText = (gstin: string) =>
    ({ format: t.gstinFormat, state: fmt(t.gstinState, { code: gstin.slice(0, 2) }), check: t.gstinCheck, '': '' })[gstinError(gstin)];

  function addItem() {
    const card = template.content.cloneNode(true) as DocumentFragment;
    items.append(card);
    renumber();
  }

  function renumber() {
    const rows = [...items.children] as HTMLElement[];
    rows.forEach((r, i) => {
      slot('n', r).textContent = String(i + 1);
      slot<HTMLButtonElement>('remove', r).hidden = rows.length === 1;
    });
  }

  /** Each item row as a Line, with the reason it can't be totalled shown under it. */
  function readLines() {
    return ([...items.children] as HTMLElement[]).map((r) => {
      const get = (k: string) => slot<HTMLInputElement>(k, r).value.trim();
      const qtyText = get('qty');
      const qty = /^(\d+(\.\d{1,3})?|\.\d{1,3})$/.test(qtyText) ? Number(qtyText) : NaN;
      const rate = toPaise(get('rate'));
      const hsn = get('hsn');
      const errors = [
        qtyText && !(qty > 0) && t.qty,
        get('rate') && Number.isNaN(rate) && t.rate,
        hsn && !/^(\d{4}|\d{6}|\d{8})$/.test(hsn) && t.hsn,
      ].filter(Boolean);
      show(slot('error', r), errors.join(' '));
      const taxable = qty > 0 && rate >= 0 ? roundPaise(qty * rate) : NaN;
      const line: Line = { desc: get('desc'), hsn, qty, unit: get('unit'), rate, gst: Number(get('gst')), taxable };
      return { row: r, line, errors };
    });
  }

  function render() {
    const sGstin = val('s-gstin').toUpperCase();
    const cGstin = val('c-gstin').toUpperCase();
    const sErr = sGstin && gstinText(sGstin);
    const cErr = cGstin && gstinText(cGstin);
    show($('s-gstin-error'), sErr || '');
    show($('c-gstin-error'), cErr || '');
    const supplierState = sGstin && !sErr ? gstinState(sGstin) : '';
    show($('s-state'), supplierState ? fmt(t.state, { state: stateName(supplierState) }) : '');
    const no = val('no');
    show(
      $('no-error'),
      no.length > 16
        ? fmt(t.noLong, { n: no.length })
        : no && !/^[A-Za-z0-9/-]+$/.test(no)
          ? t.noChars
          : '',
    );

    const place = pos.value;
    const inter = !!supplierState && !!place && supplierState !== place;
    const local = UTGST_STATES.has(place) ? 'UTGST' : 'SGST';
    $('tax-kind').textContent =
      supplierState && place
        ? inter
          ? t.inter
          : fmt(t.intra, { local })
        : t.needPlace;

    const lines = readLines().map((r) => r.line);
    const rates = new Map<number, number>();
    for (const l of lines) if (l.taxable >= 0) rates.set(l.gst, (rates.get(l.gst) ?? 0) + l.taxable);
    const groups = [...rates].sort(([a], [b]) => a - b).map(([rate, taxable]) => {
      // Each half is rounded on its own, so CGST and SGST always match, as they must on the return.
      const half = roundPaise((taxable * rate) / 200);
      return { rate, taxable, half, igst: roundPaise((taxable * rate) / 100) };
    });
    const taxable = groups.reduce((s, g) => s + g.taxable, 0);
    const tax = groups.reduce((s, g) => s + (inter ? g.igst : 2 * g.half), 0);
    const reverse = $<HTMLSelectElement>('rc').value === 'yes';
    // Under reverse charge the customer pays the tax to the government, not to you.
    const gross = reverse ? taxable : taxable + tax;
    const total = Math.round(gross / 100) * 100;

    set('no', no || blank);
    const date = val('date');
    set('date', /^\d{4}-\d{2}-\d{2}$/.test(date) ? day.format(new Date(`${date}T00:00:00Z`)) : blank);
    set('pos', place ? stateName(place) : blank);
    set('rc', reverse ? 'Yes' : 'No');
    set('s-name', val('s-name') || blank);
    set('s-name-2', val('s-name') || blank);
    set('s-address', val('s-address'));
    set('s-gstin', sGstin || blank);
    set('s-state', supplierState ? stateName(supplierState) : blank);
    set('c-name', val('c-name') || blank);
    set('c-address', val('c-address'));
    set('c-gstin', cGstin ? `GSTIN ${cGstin}` : 'Unregistered');
    set('c-state', cGstin && !cErr ? stateName(gstinState(cGstin)) : place ? stateName(place) : blank);

    slot('lines').replaceChildren(
      ...lines.map((l, i) =>
        row(
          cell(String(i + 1)),
          cell(l.desc || blank),
          cell(l.hsn),
          cell(l.qty > 0 ? `${l.qty}${l.unit ? ` ${l.unit}` : ''}` : '', 'n'),
          cell(l.rate >= 0 ? rupees(l.rate) : '', 'n'),
          cell(percent(l.gst), 'n'),
          cell(l.taxable >= 0 ? rupees(l.taxable) : '', 'n'),
        ),
      ),
    );

    const heads = inter ? ['GST rate', 'Taxable value', 'IGST', 'Total tax'] : ['GST rate', 'Taxable value', 'CGST', local, 'Total tax'];
    const headRow = document.createElement('tr');
    headRow.append(...heads.map((h, i) => Object.assign(document.createElement('th'), { textContent: h, className: i ? 'n' : '' })));
    slot('tax-head').replaceChildren(headRow);
    slot('taxes').replaceChildren(
      ...groups.map((g) =>
        inter
          ? row(cell(percent(g.rate)), cell(rupees(g.taxable), 'n'), cell(rupees(g.igst), 'n'), cell(rupees(g.igst), 'n'))
          : row(
              cell(percent(g.rate)),
              cell(rupees(g.taxable), 'n'),
              cell(`${rupees(g.half)} @ ${percent(g.rate / 2)}`, 'n'),
              cell(`${rupees(g.half)} @ ${percent(g.rate / 2)}`, 'n'),
              cell(rupees(2 * g.half), 'n'),
            ),
      ),
    );

    const totals: [string, number, string?][] = [
      ['Taxable value', taxable],
      ...((inter
        ? [['IGST', tax]]
        : [
            ['CGST', tax / 2],
            [local, tax / 2],
          ]) as [string, number][]),
      ...(reverse ? ([['Less tax payable by recipient', -tax]] as [string, number][]) : []),
      ['Round off', total - gross],
      ['Total', total, 'grand'],
    ];
    slot('totals').replaceChildren(
      ...totals.map(([label, paise, cls]) => {
        const div = Object.assign(document.createElement('div'), { className: cls ?? '' });
        const sign = label === 'Round off' && paise > 0 ? '+' : '';
        div.append(
          Object.assign(document.createElement('dt'), { textContent: label }),
          Object.assign(document.createElement('dd'), { textContent: sign + rupees(paise) }),
        );
        return div;
      }),
    );
    const safe = Number.isSafeInteger(total);
    set('words', safe ? inWords(total) : '');
    const note = slot('rc-note');
    note.hidden = !reverse;
    note.textContent = reverse ? `GST of ${rupees(tax)} on this invoice is payable by the recipient under reverse charge.` : '';

    set('bank', val('bank'));
    set('upi', val('upi') ? `UPI ${val('upi')}` : '');
    slot('pay').hidden = !val('bank') && !val('upi');
    set('notes', val('notes'));
    slot('notes-box').hidden = !val('notes');

    $('summary').textContent = safe ? fmt(t.total, { total: rupees(total) }) : t.tooLarge;
    return { taxable, safe, cGstin };
  }

  function check() {
    const { taxable, safe, cGstin } = render();
    const found: [HTMLElement, string][] = [];
    const need = (id: string, text: string) => !val(id) && found.push([field(id), text]);
    need('s-name', t.needName);
    need('s-gstin', t.needGstin);
    need('s-address', t.needAddress);
    need('c-name', t.needCustomer);
    if (cGstin || taxable >= ADDRESS_FROM) need('c-address', t.needCustomerAddress);
    need('no', t.needNo);
    need('date', t.needDate);
    if (!$<HTMLSelectElement>('pos').value) found.push([pos, t.needPlaceOfSupply]);
    for (const id of ['s-gstin-error', 'c-gstin-error', 'no-error']) {
      const text = $(id).textContent;
      if (text) found.push([field(id.replace('-error', '')), text]);
    }
    readLines().forEach(({ row: r, line, errors }, i) => {
      const at = (k: string) => slot<HTMLInputElement>(k, r);
      const n = i + 1;
      if (!line.desc) found.push([at('desc'), fmt(t.itemDesc, { n })]);
      if (!at('qty').value.trim()) found.push([at('qty'), fmt(t.itemQty, { n })]);
      if (!at('rate').value.trim()) found.push([at('rate'), fmt(t.itemRate, { n })]);
      for (const e of errors) found.push([at('desc'), fmt(t.itemError, { n, error: e as string })]);
    });
    if (!safe) found.push([items, t.tooLarge]);
    problems.replaceChildren(...found.map(([, text]) => Object.assign(document.createElement('li'), { textContent: text })));
    problems.hidden = !found.length;
    found[0]?.[0].focus();
    return !found.length;
  }

  try {
    const saved = JSON.parse(localStorage.getItem(KEY) ?? '{}');
    for (const id of REMEMBERED) if (typeof saved[id] === 'string') field(id).value = saved[id];
  } catch {}

  const today = new Date();
  field('date').value = [today.getFullYear(), today.getMonth() + 1, today.getDate()].map((n) => String(n).padStart(2, '0')).join('-');
  addItem();

  let defaulted = '';
  $('tool').addEventListener('input', (e) => {
    // The place of supply follows the customer's GSTIN until it is changed by hand.
    const c = val('c-gstin').toUpperCase();
    if (e.target === field('c-gstin') && c !== defaulted && !gstinError(c)) {
      pos.value = gstinState(c);
      defaulted = c;
    }
    if (problems.hidden) render();
    else check();
    try {
      localStorage.setItem(KEY, JSON.stringify(Object.fromEntries(REMEMBERED.map((id) => [id, field(id).value]))));
    } catch {}
  });
  $('tool').addEventListener('submit', (e) => e.preventDefault());
  $('add').addEventListener('click', () => {
    addItem();
    render();
    slot<HTMLInputElement>('desc', items.lastElementChild!).focus();
  });
  items.addEventListener('click', (e) => {
    const button = (e.target as HTMLElement).closest('[data-k="remove"]');
    if (!button) return;
    button.closest('.item')!.remove();
    renumber();
    render();
  });
  $('print').addEventListener('click', () => check() && window.print());
  render();
</script>

<style>
  .pair {
    display: grid;
    gap: 12px;
  }

  @media (min-width: 560px) {
    .pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Chrome gives date inputs a content-sized minimum that would push past a phone's edge. */
  input[type='date'] {
    min-width: 0;
  }

  ul.error {
    margin: 0;
    padding-left: 20px;
  }

  .items {
    display: grid;
    gap: 12px;
  }

  .item {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    min-width: 0;
    margin: 0;
    padding: 12px 14px 14px;
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .item .hsn {
    grid-column: 1 / -1;
  }

  @media (min-width: 640px) {
    .item {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .item .hsn {
      grid-column: auto;
    }
  }

  .item legend {
    padding-inline: 4px;
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 550;
  }

  .item .wide {
    grid-column: 1 / -1;
  }

  .remove {
    grid-column: 1 / -1;
    justify-self: end;
    margin-top: -8px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }

  #add {
    justify-self: start;
  }

  /* The invoice is paper in either theme, since that is what it becomes. */
  .sheets {
    margin-top: 16px;
  }

