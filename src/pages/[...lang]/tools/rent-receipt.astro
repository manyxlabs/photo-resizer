---
import Copy from '../../../components/Copy.astro';
import Explainer from '../../../components/Explainer.astro';
import { pageLocale } from '../../../i18n';
import { LANG_PARAMS } from '../../../i18n/locales';
import Tool from '../../../layouts/Tool.astro';

export const getStaticPaths = () => LANG_PARAMS.map((lang) => ({ params: { lang } }));

const { locale, t: all } = pageLocale(Astro.url);
const t = all.rent;
const links = {
  tax: { text: t.taxDept, href: 'https://www.incometaxindia.gov.in/w/income-from-salary' },
  form: { text: t.form124, href: 'https://www.incometaxindia.gov.in/documents/d/guest/form-124-faqs' },
  act: { text: t.stampAct, href: 'https://www.indiacode.nic.in/handle/123456789/15510' },
};
---

<Tool tool="rent-receipt" title={t.title} description={t.description} heading={t.heading} lede={t.lede} faq={t.faq}>
  <form id="tool" class="tool" novalidate data-t={JSON.stringify(t.js)}>
    <section class="panel glass">
      <h2><span>1</span> {t.parties}</h2>
      <div class="pair">
        <label class="field">{t.tenant} <input id="tenant" type="text" autocomplete="name" /></label>
        <label class="field">{t.landlord} <input id="landlord" type="text" /></label>
      </div>
      <label class="field">
        {t.pan}
        <input id="pan" type="text" maxlength="10" autocapitalize="characters" spellcheck="false" placeholder="ABCDE1234F" />
      </label>
      <p id="pan-error" class="error" role="alert" hidden></p>
      <p class="hint">{t.panHint}</p>
      <label class="field">{t.address} <textarea id="address" rows="3"></textarea></label>
    </section>

    <section class="panel glass">
      <h2><span>2</span> {t.rentAndMonths}</h2>
      <div class="pair">
        <label class="field">{t.monthly} <input id="rent" type="text" inputmode="decimal" placeholder="15000" /></label>
        <label class="field">
          {t.paidBy}
          {/* The values are what the receipt says, so they stay English. */}
          <select id="mode">
            <option value="cash">{t.cash}</option>
            <option value="UPI">{t.upi}</option>
            <option value="bank transfer">{t.bank}</option>
            <option value="cheque">{t.cheque}</option>
          </select>
        </label>
        <label class="field">{t.from} <input id="from" type="month" placeholder="2026-04" /></label>
        <label class="field">{t.to} <input id="to" type="month" placeholder="2027-03" /></label>
      </div>
      <p id="rent-error" class="error" role="alert" hidden></p>
      <p id="range-error" class="error" role="alert" hidden></p>
    </section>

    <section class="panel glass">
      <h2><span>3</span> {t.print}</h2>
      <div class="result">
        <p id="summary" aria-live="polite"></p>
        <button id="print" class="btn btn-primary" type="button">{t.print}</button>
      </div>
      <ul id="problems" class="error" role="alert" hidden></ul>
      <p class="hint">{t.printHint}</p>
      {locale !== 'en' && <p class="hint">{t.english}</p>}
    </section>
  </form>

  <div id="receipts" class="sheets" aria-label={t.preview} lang="en"></div>
  <p id="more" class="hint more" hidden></p>

  <template id="receipt" lang="en">
    <article class="receipt">
      <header>
        <h3>Rent receipt</h3>
        <p>No. <span data-k="no"></span></p>
      </header>
      <p>
        Received with thanks from <b data-k="tenant"></b> the sum of <b data-k="amount"></b> (<span data-k="words"
        ></span>) by <span data-k="mode"></span>, as rent for <span data-k="address"></span>, for the period <b
          data-k="period"></b>.
      </p>
      <footer>
        <div class="stamp" data-k="stamp">Revenue stamp</div>
        <div class="sign">
          <span data-k="landlord"></span>
          <span data-k="pan"></span>
          <span class="by">Signature of landlord</span>
        </div>
      </footer>
    </article>
  </template>

  <Explainer title={t.rules}>
    {
      t.how.map((item) => (
        <li>
          <Copy text={item} parts={links} />
        </li>
      ))
    }
  </Explainer>
</Tool>

<script>
  import type { Messages } from '../../../i18n/en';
  import { fmt, plural } from '../../../i18n/format';
  import { inWords, isPan, rupees, toPaise } from '../../../lib/money';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const field = (id: string) => $<HTMLInputElement>(id);
  const val = (id: string) => field(id).value.trim();
  const receipts = $<HTMLDivElement>('receipts');
  const template = $<HTMLTemplateElement>('receipt');
  const summary = $<HTMLParagraphElement>('summary');
  const problems = $<HTMLUListElement>('problems');
  const t: Messages['rent']['js'] = JSON.parse($('tool').dataset.t!);
  const KEY = 'rent-receipt';
  const REMEMBERED = ['tenant', 'landlord', 'address'];
  // Article 53, Indian Stamp Act: receipts for more than this carry Re 1 duty.
  const STAMP_ABOVE = 5000_00;
  const MAX_MONTHS = 24;

  const blank = '________________';
  const monthName = new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

  function show(el: HTMLElement, text: string) {
    el.textContent = text;
    el.hidden = !text;
  }

  /** Months as [year, month0] from the From and To boxes, or why they can't be used. */
  function months(): [number, number][] | string {
    const [from, to] = [val('from'), val('to')].map((v) => /^(\d{4})-(0[1-9]|1[0-2])$/.exec(v));
    if (!from || !to) return val('from') && val('to') ? t.monthFormat : '';
    const start = Number(from[1]) * 12 + Number(from[2]) - 1;
    const count = Number(to[1]) * 12 + Number(to[2]) - start;
    if (count < 1) return t.monthOrder;
    if (count > MAX_MONTHS) return fmt(t.tooManyMonths, { max: MAX_MONTHS });
    return Array.from({ length: count }, (_, i) => [Math.floor((start + i) / 12), (start + i) % 12]);
  }

  function render() {
    const rent = toPaise(val('rent'));
    const pan = val('pan').toUpperCase();
    show($('rent-error'), val('rent') && !(rent > 0) ? t.rent : '');
    show($('pan-error'), pan && !isPan(pan) ? t.pan : '');
    const list = months();
    show($('range-error'), typeof list === 'string' ? list : '');
    const mode = field('mode').value;
    receipts.replaceChildren();
    const extra = typeof list === 'string' ? 0 : list.length - 2;
    show($('more'), extra > 0 ? fmt(t.more, { n: extra }) : '');
    if (typeof list === 'string') return show(summary, '');
    for (const [y, m] of list) {
      const card = template.content.cloneNode(true) as DocumentFragment;
      const set = (k: string, text: string) => (card.querySelector(`[data-k="${k}"]`)!.textContent = text);
      set('no', `R-${y}-${String(m + 1).padStart(2, '0')}`);
      set('tenant', val('tenant') || blank);
      set('amount', rent > 0 ? rupees(rent) : blank);
      set('words', rent > 0 ? inWords(rent) : blank);
      set('mode', mode);
      set('address', val('address').replace(/[\s,]*\n[\s,]*/g, ', ') || blank);
      set('period', `${monthName.format(Date.UTC(y, m, 1))} to ${monthName.format(Date.UTC(y, m + 1, 0))}`);
      set('landlord', val('landlord') || 'Landlord');
      set('pan', isPan(pan) ? `PAN ${pan}` : '');
      (card.querySelector('[data-k="stamp"]') as HTMLElement).hidden = !(mode === 'cash' && rent > STAMP_ABOVE);
      receipts.append(card);
    }
    const total = rent > 0 ? fmt(t.total, { total: rupees(rent * list.length) }) : '';
    show(summary, plural(document.documentElement.lang, list.length, t.summary, { total }));
  }

  function check() {
    const missing = [
      ['tenant', t.needTenant],
      ['landlord', t.needLandlord],
      ['address', t.needAddress],
      ['rent', t.needRent],
      ['from', t.needFrom],
      ['to', t.needTo],
    ].filter(([id]) => !val(id!));
    const wrong = ['rent-error', 'pan-error', 'range-error'].map((id) => $(id).textContent ?? '').filter(Boolean);
    const found = [...missing.map(([, text]) => text!), ...wrong];
    problems.replaceChildren(...found.map((text) => Object.assign(document.createElement('li'), { textContent: text })));
    problems.hidden = !found.length;
    if (missing.length) field(missing[0]![0]!).focus();
    return !found.length;
  }

  try {
    const saved = JSON.parse(localStorage.getItem(KEY) ?? '{}');
    for (const id of REMEMBERED) if (typeof saved[id] === 'string') field(id).value = saved[id];
  } catch {}

  // Default to the current financial year, April to March, the period an HRA claim covers.
  const now = new Date();
  const fy = now.getMonth() < 3 ? now.getFullYear() - 1 : now.getFullYear();
  field('from').value = `${fy}-04`;
  field('to').value = `${fy + 1}-03`;

  $('tool').addEventListener('input', () => {
    render();
    if (!problems.hidden) check();
    try {
      localStorage.setItem(KEY, JSON.stringify(Object.fromEntries(REMEMBERED.map((id) => [id, field(id).value]))));
    } catch {}
  });
  $('tool').addEventListener('submit', (e) => e.preventDefault());
  $('print').addEventListener('click', () => check() && window.print());
  render();
</script>

<style>
  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  /* Chrome gives date inputs a content-sized minimum that would push past a phone's edge. */
  input[type='month'] {
    min-width: 0;
  }

  ul.error {
    margin: 0;
    padding-left: 20px;
  }

  /* The receipts are paper in either theme, since that is what they become. */
  .sheets {
    display: grid;
    gap: 16px;
    margin-top: 16px;
  }

  /* On screen a few receipts show what the rest look like; all of them print. */
  @media screen {
    .sheets > :global(.receipt:nth-child(n + 3)) {
      display: none;
    }
  }

  .more {
    margin-top: 12px;
    text-align: center;
  }

  .receipt {
    display: grid;
    gap: 14px;
    padding: 20px;
    border: 1px solid #d4d4d8;
    border-radius: 4px;
    background: #fff;
    color: #1d1d1f;
    font-size: 0.9375rem;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  .receipt header {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 10px;
    border-bottom: 1px solid #d4d4d8;
  }

  .receipt h3 {
    margin: 0;
    font-size: 1.0625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .receipt footer {
    display: flex;
    gap: 16px;
    align-items: flex-end;
    justify-content: flex-end;
  }

  .stamp {
    display: grid;
    flex: none;
    place-items: center;
    width: 72px;
    height: 84px;
    border: 1px dashed #8e8e93;
    color: #6e6e73;
    font-size: 0.6875rem;
    line-height: 1.2;
    text-align: center;
  }

  .sign {
    display: grid;
    min-width: min(220px, 100%);
    text-align: right;
  }

  .sign .by {
    margin-top: 36px;
    padding-top: 4px;
    border-top: 1px solid #1d1d1f;
    color: #6e6e73;
    font-size: 0.8125rem;
  }

  @media print {
    @page {
      size: A4;
      margin: 10mm;
    }

    :global(body > :not(main)),
    :global(main > :not(.sheets)) {
      display: none !important;
    }

    :global(body),
    :global(main) {
      margin: 0;
      padding: 0 !important;
      max-width: none !important;
      background: #fff;
    }

    .sheets {
      display: block;
      margin: 0;
    }

    /* Sized so four fit on an A4 page. */
    .receipt {
      gap: 3mm;
      margin-bottom: 5mm;
      padding: 5mm 6mm;
      break-inside: avoid;
      font-size: 10pt;
      line-height: 1.4;
    }

    .receipt header {
      padding-bottom: 2mm;
    }

    .stamp {
      width: 18mm;
      height: 21mm;
    }

    .sign .by {
      margin-top: 7mm;
    }
  }
</style>
