---
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { CHECKED, exams, kbRange, reportHref, type Exam, type FormSpec } from '../../data/formSpecs';
import { PHOTO_KB, SIGN_KB } from '../../data/tools';
import Base from '../../layouts/Base.astro';
import { breadcrumbs } from '../../seo';

export function getStaticPaths() {
  return exams.map((exam) => ({ params: { exam: exam.id }, props: { exam } }));
}

const { exam } = Astro.props as { exam: Exam };
// "Signature (three in one image)" reads as "signature" in a sentence.
const noun = (label: string) => label.replace(/ \(.*\)$/, '').toLowerCase();
const list = (words: string[]) => new Intl.ListFormat('en').format(words);
const what = list(exam.specs.map((s) => noun(s.label)));
const title = `${exam.name} photo and signature size ${CHECKED.year}`;
const page = `/photo-size/${exam.id}/`;
const summary = exam.specs
  .slice(0, 2)
  .map((s) => `${noun(s.label)} ${s.width} × ${s.height} px, ${kbRange(s)}`)
  .join('; ');
// The longest description that still fits a search result (155 characters).
const description = [`${exam.name} (${exam.covers})`, `${exam.name} ${CHECKED.year}`]
  .map((who) => `${who}: ${summary}${exam.specs.length > 2 ? ', and more' : ''}. From the official notice, with a free tool to resize yours.`)
  .find((d, i, all) => d.length <= 155 || i === all.length - 1)!;
const toolFor = (spec: FormSpec) => (spec.scan ? '/tools/signature-resizer/' : '/tools/passport-photo/');
const sizePage = (spec: FormSpec) =>
  spec.scan
    ? SIGN_KB.includes(spec.maxKB) && { name: `Signature under ${spec.maxKB} KB`, href: `/tools/signature-resizer/${spec.maxKB}-kb/` }
    : PHOTO_KB.includes(spec.maxKB) && { name: `Photo under ${spec.maxKB} KB`, href: `/tools/photo-resizer/${spec.maxKB}-kb/` };
const photos = exam.specs.filter((s) => !s.scan);
const scans = exam.specs.filter((s) => s.scan);
const named = exam.specs.filter((s) => s.fileName).map((s) => `${s.fileName}.jpg`);
const steps: [name: string, text: string][] = [
  [
    'Take the picture',
    [
      photos.length > 0 &&
        'For the photo, stand against a plain white wall in even light and have someone take it from about 1.5 metres away.',
      scans.length > 0 &&
        `For the ${list(scans.map((s) => noun(s.label)))}, use plain white paper and dark ink, and photograph it from straight above in good light.`,
    ]
      .filter(Boolean)
      .join(' '),
  ],
  [
    `Open it with the ${exam.name} preset`,
    `Press the button under each size above. It opens the tool on that preset, which sets the pixels${exam.specs.some((s) => s.physical) ? ', DPI' : ''} and KB from the notice.`,
  ],
  [
    'Adjust and download',
    `Drag or zoom to frame it, then download the JPG. It already fits the KB range${named.length ? ` and is named ${list(named)}` : ''}.`,
  ],
  ['Upload and check', `Upload it to the ${exam.name} form and check the preview before you submit.`],
];
---

<Base
  title={title}
  description={description}
  og={`guide-${exam.id}`}
  schema={[
    {
      '@type': 'HowTo',
      name: `How to make your ${exam.name} ${what}`,
      tool: [...new Set(exam.specs.map((s) => (s.scan ? 'Signature cleaner' : 'Passport photo maker')))].map((name) => ({ '@type': 'HowToTool', name })),
      step: steps.map(([name, text], i) => ({ '@type': 'HowToStep', position: i + 1, name, text, url: `${new URL(page, Astro.site)}#step-${i + 1}` })),
    },
    breadcrumbs([
      ['Manyx Labs', '/'],
      ['Size guides', '/photo-size/'],
      [title, page],
    ]),
  ]}
>
  <Header />

  <main class="wrap">
    <p class="eyebrow">Form size guide</p>
    <h1>{title}</h1>
    <p class="lede">
      {`What ${exam.name} asks for (${exam.covers}), taken from the official notice and checked in ${CHECKED.month} ${CHECKED.year}.`}
    </p>

    {
      exam.specs.map((spec) => {
        const size = sizePage(spec);
        return (
          <section class="spec glass" aria-labelledby={`${spec.id}-h`} id={spec.id}>
            <h2 id={`${spec.id}-h`}>{spec.label}</h2>
            <dl>
              <dt>Size</dt>
              <dd>
                {spec.width} × {spec.height} pixels
                {spec.physical && ` (${spec.physical.w} × ${spec.physical.h} cm at ${spec.physical.dpi} DPI)`}
              </dd>
              <dt>File size</dt>
              <dd>{kbRange(spec)}</dd>
              <dt>Format</dt>
              <dd>JPG{spec.fileName && `, named ${spec.fileName}.jpg`}</dd>
            </dl>
            <div class="go">
              <a class="btn primary" href={`${toolFor(spec)}?preset=${spec.id}`}>
                {`Resize your ${exam.name} ${noun(spec.label)}`}
              </a>
              {size && <a href={size.href}>{size.name}</a>}
            </div>
          </section>
        );
      })
    }

    <section aria-labelledby="how">
      <h2 id="how">{`How to make your ${exam.name} ${what}`}</h2>
      <ol class="notes">
        {
          steps.map(([name, text], i) => (
            <li id={`step-${i + 1}`}>
              <strong>{name}.</strong> {text}
            </li>
          ))
        }
      </ol>
    </section>

    <section aria-labelledby="notes">
      <h2 id="notes">Good to know</h2>
      <ul class="notes">
        {exam.notes.map((note) => <li>{note}</li>)}
      </ul>
    </section>

    <p class="source">
      Source: <a href={exam.source.url}>{exam.source.label}</a>. Rules change between notices, so check the one
      for your exam before you submit. <a href={reportHref(exam.specs[0])}>Spec wrong or changed?</a>
    </p>

    <p class="others">
      Other forms:{' '}
      {
        exams
          .filter((e) => e !== exam)
          .map((e, i) => (
            <>
              {i > 0 && ' · '}
              <a href={`/photo-size/${e.id}/`}>{`${e.name} photo and signature size`}</a>
            </>
          ))
      }
    </p>
  </main>

  <Footer />
</Base>

<style>
  main {
    max-width: 760px;
    padding-block: 32px 64px;
  }

  .eyebrow {
    color: var(--accent);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin-top: 8px;
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .lede {
    margin-top: 8px;
    color: var(--muted);
  }

  h2 {
    font-size: 1.0625rem;
    font-weight: 620;
  }

  .spec {
    display: grid;
    gap: 14px;
    justify-items: start;
    margin-top: 16px;
    padding: 20px;
    border-radius: 20px;
  }

  .go {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
    align-items: center;
  }

  .spec:first-of-type {
    margin-top: 32px;
  }

  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 6px 16px;
    margin: 0;
  }

  dt {
    color: var(--muted);
  }

  dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  section:not(.spec) {
    margin-top: 40px;
  }

  .notes {
    display: grid;
    gap: 8px;
    margin: 12px 0 0;
    padding-left: 20px;
  }

  .source,
  .others {
    margin-top: 24px;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  main a:not(.btn) {
    color: var(--accent);
  }
</style>
