---
import { PASSPORT_FAQ } from '../../data/faq';
import Explainer from '../../components/Explainer.astro';
import Resizer from '../../components/Resizer.astro';
import Tool from '../../layouts/Tool.astro';
---

<Tool
  path="/tools/passport-photo/"
  title="Passport Size Photo Maker: Indian passport, exam forms and print sheets - Manyx Labs"
  description="Make a 630 × 810 Indian passport photo or an exam form photo from any picture, framed on your face, with an optional white background and a 6 × 4 inch print sheet. Free, and nothing is uploaded."
  faq={PASSPORT_FAQ}
  heading="Passport size photo maker"
  applicationCategory="MultimediaApplication"
>
  <Fragment slot="lede">
    For the Indian passport and exam forms: framed on your face, at the exact size and KB, with a sheet of copies to
    print. It all happens on your device; nothing is uploaded.
  </Fragment>

  <Resizer kind="photo" />

  <Explainer title="How it works">
    <li>
      The photo is framed on your face the way passport photos are: head and top of the shoulders, with a little room
      above your hair. Drag or zoom to adjust.
    </li>
    <li>
      "Replace the background with white" finds you in the picture and paints the rest white. Check the result around
      your hair before you use it. The passport notice asks for photos unaltered by software, so for a passport, a
      plain white wall behind you is the safer choice.
    </li>
    <li>
      The print sheet fits as many copies as it can on a 6 × 4 inch photo print, at 300 DPI, with light lines to cut
      along. Any photo shop or home printer can print it.
    </li>
    <li>The face finder and background tool run in your browser; the photo never leaves your device.</li>
  </Explainer>
</Tool>
