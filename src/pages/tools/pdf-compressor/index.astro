---
import Explainer from '../../../components/Explainer.astro';
import { PDF_FAQ } from '../../../data/faq';
import { PDF_KB, sizeLabel, sizeSlug } from '../../../data/tools';
import PdfCompressor from '../../../components/PdfCompressor.astro';
import Tool from '../../../layouts/Tool.astro';
---

<Tool
  path="/tools/pdf-compressor/"
  title="Compress PDF to 100 KB, 200 KB or Any Size"
  description="Shrink a PDF under the KB limit your exam, job or government form allows, and merge PDFs and photos into one. Free, no signup, and nothing is uploaded."
  heading="Compress a PDF to any size, and merge PDFs"
  faq={PDF_FAQ}
>
  <Fragment slot="lede">
    Merge PDFs and photos into one PDF and get it under the KB your form allows. It all happens on your device;
    nothing is uploaded.
  </Fragment>

  <PdfCompressor />

  <p class="sizes">
    Need a specific size?{' '}
    {
      PDF_KB.map((kb, i) => (
        <>
          {i > 0 && ' · '}
          <a href={`/tools/pdf-compressor/${sizeSlug(kb)}/`}>{`PDF under ${sizeLabel(kb)}`}</a>
        </>
      ))
    }
  </p>

  <Explainer title="How it works">
    <li>
      Your files are joined into one PDF in the order you set, with each photo placed on its own A4 page.
    </li>
    <li>
      Nothing is uploaded. The work happens in your browser, so it is safe for Aadhaar, marksheets and other private
      documents.
    </li>
    <li>
      It first tries to keep your PDFs exactly as they are. If that is already small enough, the text stays sharp and
      can still be selected and searched.
    </li>
    <li>
      If not, every page is turned into a picture at the highest sharpness that fits your limit. The pages look the
      same when printed, but the text can no longer be selected, searched or copied. The result tells you when this
      has happened.
    </li>
  </Explainer>
</Tool>

<style>
  .sizes {
    margin-top: 24px;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .sizes a {
    color: var(--accent);
  }
</style>
