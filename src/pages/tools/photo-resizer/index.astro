---
import { RESIZER_FAQ } from '../../../data/faq';
import Resizer from '../../../components/Resizer.astro';
import SizeLinks from '../../../components/SizeLinks.astro';
import Tool from '../../../layouts/Tool.astro';
---

<Tool
  path="/tools/photo-resizer/"
  title="Photo & Signature Resizer in KB for Exam Forms"
  description="Resize a photo or signature to the exact pixels and KB SSC, UPSC, IBPS or PAN forms ask for, from JPG, PNG, HEIC or TIFF. Free, and nothing is uploaded."
  faq={RESIZER_FAQ}
  heading="Photo & signature resizer for exam forms"
  applicationCategory="MultimediaApplication"
>
  <Fragment slot="lede">
    Get your photo or signature to the exact size and KB your form asks for. It all happens on your device; nothing is
    uploaded.
  </Fragment>

  <Resizer />

  <SizeLinks />
</Tool>
