---
import { SIGNATURE_FAQ } from '../../../data/faq';
import Explainer from '../../../components/Explainer.astro';
import Resizer from '../../../components/Resizer.astro';
import SizeLinks from '../../../components/SizeLinks.astro';
import Tool from '../../../layouts/Tool.astro';
---

<Tool
  path="/tools/signature-resizer/"
  title="Signature Resizer & Cleaner for Exam and PAN Forms"
  description="Turn a phone photo of your signature into a clean scan at the exact size and KB SSC, IBPS, UPSC or PAN asks for. Free, and nothing is uploaded."
  faq={SIGNATURE_FAQ}
  heading="Signature cleaner & resizer"
>
  <Fragment slot="lede">
    Sign on white paper, take a photo with your phone, and get a clean scan at the size your form asks for. It all
    happens on your device; nothing is uploaded.
  </Fragment>

  <Resizer kind="scan" />

  <Explainer title="How it works">
    <li>
      Shadows and uneven light on the paper are evened out, so the paper turns pure white and the ink stays sharp.
    </li>
    <li>The picture is trimmed to your signature, so you don't need to crop it yourself. Drag or zoom to adjust.</li>
    <li>
      Pick black ink if your form asks for it: IBPS, for example, wants a signature in black ink on white paper.
    </li>
    <li>The same steps work for a thumb impression or a hand-written declaration.</li>
  </Explainer>

  <SizeLinks kind="scan" />
</Tool>
